{
  "name": "ryb-limpiezas-functions",
  "description": "Cloud Functions para RyB Limpiezas App",
  "version": "1.0.1",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.5",
    "stripe": "^18.5.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  }
}
